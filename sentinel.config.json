{
  "schemaVersion": 2,
  "mode": "enforce",
  "project": {
    "primaryBranch": "main"
  },
  "gate": {
    "command": ["sentinel", "check", "--"],
    "taskIdRequired": true
  },
  "guard": {
    "directCommands": {
      "npmScripts": [],
      "npxTools": [],
      "cargoSubcommands": ["check", "clippy", "test", "bench", "fmt"],
      "tools": ["rustfmt"]
    }
  },
  "runtime": {
    "minimumVersion": "0.7.5",
    "protocolVersion": 1,
    "lockFile": "sentinel.lock.json"
  },
  "analyzers": {
    "sentinel": {
      "enabled": true,
      "profile": "project-default",
      "config": {
        "includePatterns": [
          "**/*.rs",
          "desktop/ui/src/**/*.ts",
          "desktop/ui/vite.config.ts",
          "**/*.mjs",
          "Cargo.toml",
          "Cargo.lock",
          "package.json",
          "core/Cargo.toml",
          "cli/Cargo.toml",
          "desktop/src-tauri/Cargo.toml",
          "desktop/ui/package.json"
        ],
        "excludePatterns": [
          "**/target/**",
          "**/node_modules/**",
          "**/.quality-tools/**",
          "**/.quality-reports/**",
          "**/.sentinel/**"
        ],
        "directoryExceptions": [
          "desktop/ui/src/componentes",
          "desktop/ui/src/orquestador"
        ],
        "portableBoundaries": {
          "dom": ["/platform/", "/plataforma/", "/adapters/", "/dom."],
          "window": ["/platform/", "/plataforma/", "/adapters/", "/navigation/"]
        },
        "rules": {
          "barras-decorativas": { "severidad": "warning" },
          "catch-vacio": { "severidad": "error" },
          "hardcoded-secret": { "severidad": "error" },
          "innerhtml-variable": { "severidad": "error" },
          "unwrap-produccion-rs": { "severidad": "error" },
          "panic-produccion-rs": { "severidad": "error" },
          "git-add-all": { "severidad": "error" },
          "unsafe-process-shell": { "severidad": "error" }
        }
      }
    },
    "varsense": {
      "enabled": true,
      "profile": "project-default",
      "config": "varsense.config.json"
    }
  }
}